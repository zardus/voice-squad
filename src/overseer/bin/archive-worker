#!/bin/bash
# archive-worker — Archive a completed worker
# Usage: archive-worker PROJECT_NAME WORKER_NAME
# Reads summary from stdin → .summary, captures full pane → .log,
# moves .task to archived, kills the worker tmux window.

set -euo pipefail

PROJECT_NAME="${1:?Usage: archive-worker PROJECT_NAME WORKER_NAME}"
WORKER_NAME="${2:?Usage: archive-worker PROJECT_NAME WORKER_NAME}"

SOCKET="/run/squad-sockets/projects/${PROJECT_NAME}/default"
ARCHIVE_DIR="$HOME/tasks/archived"
PENDING_DIR="$HOME/tasks/pending"

mkdir -p "$ARCHIVE_DIR"

# Read summary from stdin
cat > "$ARCHIVE_DIR/${WORKER_NAME}.summary"

if tmux -S "$SOCKET" has-session -t agents 2>/dev/null; then
    # Find the window by name
    WINDOW_INDEX=$(tmux -S "$SOCKET" list-windows -t agents -F '#{window_name} #{window_index}' 2>/dev/null \
        | awk -v name="$WORKER_NAME" '$1 == name { print $2; exit }')

    if [ -n "$WINDOW_INDEX" ]; then
        PANE_INFO=$(tmux -S "$SOCKET" list-panes -t "agents:${WINDOW_INDEX}" -F '#{pane_id} #{pane_current_command}' 2>/dev/null | head -1 || true)
        PANE_ID=$(printf '%s\n' "$PANE_INFO" | awk '{print $1}')
        CURRENT_CMD=$(printf '%s\n' "$PANE_INFO" | awk '{print $2}')

        if [ -z "$PANE_ID" ]; then
            echo "WARNING: Worker '${PROJECT_NAME}/${WORKER_NAME}' has no pane" >&2
        elif [ "$CURRENT_CMD" = "claude" ] || [ "$CURRENT_CMD" = "codex" ] || [ "$CURRENT_CMD" = "node" ] || [ "$CURRENT_CMD" = "npm" ]; then
            # Capture full pane output
            tmux -S "$SOCKET" capture-pane -t "$PANE_ID" -p -S -10000 > "$ARCHIVE_DIR/${WORKER_NAME}.log" 2>/dev/null || true
        else
            echo "WARNING: Worker '${PROJECT_NAME}/${WORKER_NAME}' pane is running '$CURRENT_CMD'; capturing output anyway." >&2
            tmux -S "$SOCKET" capture-pane -t "$PANE_ID" -p -S -10000 > "$ARCHIVE_DIR/${WORKER_NAME}.log" 2>/dev/null || true
        fi

        # Kill the window (not the session)
        tmux -S "$SOCKET" kill-window -t "agents:${WORKER_NAME}" 2>/dev/null || true
    else
        echo "WARNING: No worker window '${WORKER_NAME}' found in project '${PROJECT_NAME}' (may have already exited)" >&2
    fi
else
    echo "WARNING: No agents session found for project '${PROJECT_NAME}' (may have already stopped)" >&2
fi

# Move task file to archived
if [ -f "$PENDING_DIR/${WORKER_NAME}.task" ]; then
    mv "$PENDING_DIR/${WORKER_NAME}.task" "$ARCHIVE_DIR/${WORKER_NAME}.task"
fi

echo "Worker '${PROJECT_NAME}/${WORKER_NAME}' archived."
