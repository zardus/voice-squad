#!/bin/bash
# list-workers — List active workers across all project containers
# Usage: list-workers
# Output format: PROJECT_NAME/WORKER_NAME (one per line)

set -euo pipefail

PROJECTS_DIR="/run/squad/tmux/projects"
output=""

if [ -d "$PROJECTS_DIR" ]; then
    for socket in "$PROJECTS_DIR"/*/default; do
        [ -S "$socket" ] || continue
        project_name=$(basename "$(dirname "$socket")")

        windows=$(tmux -S "$socket" list-windows -t agents -F '#{window_name} #{window_index}' 2>/dev/null || true)
        [ -z "$windows" ] && continue

        while read -r window_name window_index; do
            pane_cmd=$(tmux -S "$socket" list-panes -t "agents:${window_index}" -F '#{pane_current_command}' 2>/dev/null | head -1 || true)
            case "$pane_cmd" in
                claude|codex|node|npm)
                    output="${output}${project_name}/${window_name}"$'\n'
                    ;;
            esac
        done <<< "$windows"
    done
fi

if [ -n "$output" ]; then
    printf '%s' "$output"
else
    echo "(no workers)"
fi
