#!/bin/bash
# stop-project — Stop and remove a per-project Docker container
# Usage: stop-project PROJECT_NAME

set -euo pipefail

PROJECT_NAME="${1:?Usage: stop-project PROJECT_NAME}"

CONTAINER_NAME="squad-project-${PROJECT_NAME}"
SOCKET_DIR="/run/squad-sockets/projects/${PROJECT_NAME}"

docker stop "$CONTAINER_NAME" 2>/dev/null || true
docker rm "$CONTAINER_NAME" 2>/dev/null || true

# Clean up socket directory
rm -rf "$SOCKET_DIR" 2>/dev/null || true

echo "Project '${PROJECT_NAME}' stopped."
