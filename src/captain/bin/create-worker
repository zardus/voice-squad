#!/bin/bash
# create-worker — Create a worker as a tmux window in a project's agents session
# Usage: create-worker <claude|codex> [-e ENV=VAL ...] PROJECT_NAME TASK_NAME

set -euo pipefail

TOOL="${1:?Usage: create-worker <claude|codex> [-e ENV=VAL ...] PROJECT_NAME TASK_NAME}"
shift

if [ "$TOOL" != "claude" ] && [ "$TOOL" != "codex" ]; then
    echo "ERROR: Tool must be 'claude' or 'codex' (got '$TOOL')" >&2
    exit 1
fi

# Collect -e flags
TMUX_ENV_FLAGS=()
while [[ "${1:-}" == "-e" ]]; do
    shift
    TMUX_ENV_FLAGS+=("-e" "$1")
    shift
done

PROJECT_NAME="${1:?Missing PROJECT_NAME}"
TASK_NAME="${2:?Missing TASK_NAME}"

TASK_FILE="$HOME/captain/tasks/pending/${TASK_NAME}.task"
if [ ! -f "$TASK_FILE" ]; then
    echo "ERROR: Task file not found: $TASK_FILE" >&2
    exit 1
fi

SOCKET="/run/squad-sockets/projects/${PROJECT_NAME}/default"

if ! tmux -S "$SOCKET" has-session -t agents 2>/dev/null; then
    echo "ERROR: No agents session found for project '${PROJECT_NAME}'. Is the project started?" >&2
    exit 1
fi

# Check if a window with this name already exists
if tmux -S "$SOCKET" list-windows -t agents -F '#{window_name}' 2>/dev/null | grep -q "^${TASK_NAME}$"; then
    echo "ERROR: Worker window '${TASK_NAME}' already exists in project '${PROJECT_NAME}'" >&2
    exit 1
fi

# Build the worker command
if [ "$TOOL" = "claude" ]; then
    WORKER_CMD="claude --dangerously-skip-permissions \"\$(cat ~/captain/tasks/pending/${TASK_NAME}.task)\""
else
    WORKER_CMD="codex --dangerously-bypass-approvals-and-sandbox \"\$(cat ~/captain/tasks/pending/${TASK_NAME}.task)\""
fi

# Source env then run worker
FULL_CMD="{ [ -f /home/ubuntu/env ] && set -a && . /home/ubuntu/env && set +a || true; } && $WORKER_CMD"

# Create a new window in the agents session for this worker
tmux -S "$SOCKET" new-window ${TMUX_ENV_FLAGS[@]+"${TMUX_ENV_FLAGS[@]}"} -t agents -n "$TASK_NAME" -c /home/ubuntu
sleep 0.5
tmux -S "$SOCKET" send-keys -t "agents:${TASK_NAME}" "$FULL_CMD"
sleep 1
tmux -S "$SOCKET" send-keys -t "agents:${TASK_NAME}" Enter

# ---------------------------------------------------------------------------
# Auto-accept trust/setup dialogs (Claude only)
# ---------------------------------------------------------------------------
if [ "$TOOL" = "claude" ]; then
    echo "Waiting for Claude worker to start (handling dialogs)..."
    TMUX_TARGET="agents:${TASK_NAME}"
    for i in $(seq 1 15); do
        sleep 2

        PANE_TEXT=$(tmux -S "$SOCKET" capture-pane -t "$TMUX_TARGET" -p -S -30 2>/dev/null \
            | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' || true)
        HANDLED=""

        # Setup dialogs (text style, getting started)
        if echo "$PANE_TEXT" | grep -q "Choose the text style\|Let's get started"; then
            echo "[create-worker] Handling setup dialog..."
            tmux -S "$SOCKET" send-keys -t "$TMUX_TARGET" Enter
            HANDLED=1

        # Trust dialog: "Yes, I accept" + "Enter to confirm"
        elif echo "$PANE_TEXT" | grep -q "Yes, I accept"; then
            if echo "$PANE_TEXT" | grep -q "Enter to confirm"; then
                echo "[create-worker] Accepting trust dialog..."
                tmux -S "$SOCKET" send-keys -t "$TMUX_TARGET" 2
                sleep 0.5
                tmux -S "$SOCKET" send-keys -t "$TMUX_TARGET" Enter
                HANDLED=1
            else
                # Claude may have exited at trust prompt — dismiss and restart
                echo "[create-worker] Claude exited at trust prompt, restarting..."
                tmux -S "$SOCKET" send-keys -t "$TMUX_TARGET" Enter
                sleep 1
                tmux -S "$SOCKET" send-keys -t "$TMUX_TARGET" "$FULL_CMD"
                sleep 0.5
                tmux -S "$SOCKET" send-keys -t "$TMUX_TARGET" Enter
                HANDLED=1
            fi

        # Other "Enter to confirm" dialogs
        elif echo "$PANE_TEXT" | grep -q "Enter to confirm"; then
            echo "[create-worker] Accepting dialog..."
            tmux -S "$SOCKET" send-keys -t "$TMUX_TARGET" Enter
            HANDLED=1
        fi

        # If no dialog detected after initial startup period, worker is past dialogs
        if [ -z "$HANDLED" ] && [ "$i" -ge 5 ]; then
            echo "[create-worker] No dialog detected, worker running."
            break
        fi
    done
fi

echo "Worker '${TASK_NAME}' created ($TOOL) in project '${PROJECT_NAME}'."
