#!/bin/bash
# send-keys-to-worker — Send keystrokes to a worker pane
# Usage: send-keys-to-worker PROJECT_NAME WORKER_NAME KEYS...
# Safety-checks that the pane is running a known agent process before sending.

set -euo pipefail

PROJECT_NAME="${1:?Usage: send-keys-to-worker PROJECT_NAME WORKER_NAME KEYS...}"
WORKER_NAME="${2:?Usage: send-keys-to-worker PROJECT_NAME WORKER_NAME KEYS...}"
shift 2

if [ $# -eq 0 ]; then
    echo "ERROR: No keys specified" >&2
    exit 1
fi

SOCKET="/run/squad-sockets/projects/${PROJECT_NAME}/default"

if ! tmux -S "$SOCKET" has-session -t agents 2>/dev/null; then
    echo "ERROR: No agents session found for project '${PROJECT_NAME}'" >&2
    exit 1
fi

# Find the window by name
WINDOW_INDEX=$(tmux -S "$SOCKET" list-windows -t agents -F '#{window_name} #{window_index}' 2>/dev/null \
    | awk -v name="$WORKER_NAME" '$1 == name { print $2; exit }')

if [ -z "$WINDOW_INDEX" ]; then
    echo "ERROR: No worker window '${WORKER_NAME}' found in project '${PROJECT_NAME}'" >&2
    exit 1
fi

PANE_INFO=$(tmux -S "$SOCKET" list-panes -t "agents:${WINDOW_INDEX}" -F '#{pane_id} #{pane_current_command}' 2>/dev/null | head -1 || true)
PANE_ID=$(printf '%s\n' "$PANE_INFO" | awk '{print $1}')
CURRENT_CMD=$(printf '%s\n' "$PANE_INFO" | awk '{print $2}')

if [ -z "$PANE_ID" ]; then
    echo "ERROR: Worker '${PROJECT_NAME}/${WORKER_NAME}' has no pane" >&2
    exit 1
fi

# Safety check: verify the pane is running a known agent process
case "$CURRENT_CMD" in
    claude|codex|node|npm) ;;
    *)
        echo "ERROR: Worker '${PROJECT_NAME}/${WORKER_NAME}' is running '$CURRENT_CMD', not an agent process. Refusing to send keys." >&2
        exit 1
        ;;
esac

# When the last arg is Enter, send preceding keys first, then delay
# so the agent UI has time to process pasted text before submission.
LAST_ARG="${!#}"
if [ "$LAST_ARG" = "Enter" ] && [ $# -gt 1 ]; then
    ARGS=("$@")
    unset 'ARGS[${#ARGS[@]}-1]'
    tmux -S "$SOCKET" send-keys -t "$PANE_ID" "${ARGS[@]}"
    sleep 1
    tmux -S "$SOCKET" send-keys -t "$PANE_ID" Enter
else
    tmux -S "$SOCKET" send-keys -t "$PANE_ID" "$@"
fi
